# Copy to csi/.env on the CSI processing laptop. Never commit csi/.env.
# Backend that receives room-presence results (same origin as the app).
BACKEND_URL=http://127.0.0.1:8080
# Issued once by: python -m backend.manage create-sensor --name "ESP32 Room 101" --room "Room 101"
# (or Administration > CSI sensors in the app). The room must match the class room exactly.
CSI_SERVICE_TOKEN=
SERIAL_PORT=COM3
SERIAL_BAUD=921600
MODEL_PATH=models/presence.joblib
REPORT_INTERVAL_S=1
# Optional: bind readings to one session id
SESSION_ID=
