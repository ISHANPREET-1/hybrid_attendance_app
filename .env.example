# Local development uses SQLite when DATABASE_URL is empty.
# Vercel MUST use a hosted PostgreSQL URL, with sslmode=require.
DATABASE_URL=
# Generate a long random token; needed for one-time first-administrator setup.
ADMIN_SETUP_TOKEN=
# Your deployed HTTPS origin, with no trailing slash; local development can omit.
APP_ORIGIN=
# true on any HTTPS host; Vercel enables this automatically.
COOKIE_SECURE=false
# Optional comma-separated PUBLIC campus egress CIDRs, configured by your college.
# Do not use private Wi-Fi/LAN CIDRs for a Vercel-hosted app.
CAMPUS_CIDRS=
