# Local development uses SQLite when DATABASE_URL is empty.
# Vercel MUST use a hosted PostgreSQL URL, with sslmode=require.
DATABASE_URL=
# Generate a long random token; needed for one-time first-administrator setup.
ADMIN_SETUP_TOKEN=
# Your deployed HTTPS origin, with no trailing slash; local development can omit.
APP_ORIGIN=
# true on any HTTPS host; Vercel enables this automatically.
COOKIE_SECURE=false
# Optional comma-separated PUBLIC campus egress CIDRs, configured by your college.
# Do not use private Wi-Fi/LAN CIDRs for a Vercel-hosted app.
CAMPUS_CIDRS=
# Optional automatic first-admin setup. Only used when no administrator exists.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
# Hybrid verification (Wi-Fi + CSI). Default classroom SSID offered when opening sessions.
ATTENDANCE_SSID=ATTENDANCE_WIFI
# Maximum age in seconds of a CSI reading the backend accepts (sessions may set 5-600).
CSI_MAX_AGE_S=30
# Demo only: let readings tagged REPLAY (recorded data) satisfy the CSI check. Keep false.
CSI_ALLOW_REPLAY=false
