# Fill DATABASE_URL with your real hosted PostgreSQL connection string.
DATABASE_URL=
ADMIN_SETUP_TOKEN=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrator
