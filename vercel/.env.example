# Fill DATABASE_URL with your real hosted PostgreSQL connection string.
DATABASE_URL=
ADMIN_SETUP_TOKEN=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrator
# Optional: exact production HTTPS origin. Leave empty for automatic same-origin.
APP_ORIGIN=
COOKIE_SECURE=true
# Optional: actual public campus egress networks, comma-separated.
CAMPUS_CIDRS=
# A whole class often signs in from one campus NAT address; raise the per-IP login cap.
AUTH_IP_LIMIT=1000
# Classroom Wi-Fi name offered by default when opening a session.
ATTENDANCE_SSID=ATTENDANCE_WIFI
